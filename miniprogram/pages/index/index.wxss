.page { padding-bottom: 40rpx; }
.hero {
  background: linear-gradient(135deg, #1f7a4d, #2e9e5b);
  color: #fff; padding: 40rpx 32rpx 90rpx;
}
.brand { font-size: 26rpx; opacity: .95; }
.hero-title { font-size: 46rpx; font-weight: 700; line-height: 1.35; margin: 24rpx 0 12rpx; white-space: pre-line; }
.hero-sub { font-size: 24rpx; opacity: .88; }
.upload {
  border: 3rpx dashed #b9d8c6; border-radius: 20rpx; background: #fafdfb;
  min-height: 320rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.upload-icon { font-size: 88rpx; }
.upload-t { font-size: 28rpx; font-weight: 600; margin-top: 12rpx; }
.upload-s { font-size: 22rpx; color: #9aab9f; margin-top: 8rpx; }
.preview { width: 100%; height: 420rpx; border-radius: 16rpx; background: #f0f4f1; }
.btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btns .btn-primary { flex: 1; }
.btn-ghost { background: #e8f5ee; color: #155c39; border-radius: 16rpx; font-size: 28rpx; padding: 18rpx 28rpx; }
.btn-ghost::after { border: none; }
.tip { font-size: 22rpx; color: #9aab9f; margin-top: 20rpx; line-height: 1.6; }
.result { margin-top: 0; }
.demo-tag { font-size: 20rpx; background: #f0f0f0; color: #999; padding: 4rpx 14rpx; border-radius: 20rpx; margin-left: 12rpx; }
.diag { display: flex; align-items: center; gap: 20rpx; }
.diag-emoji { font-size: 60rpx; width: 100rpx; height: 100rpx; background: #e8f5ee; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; }
.diag-info { flex: 1; }
.diag-name { font-size: 36rpx; font-weight: 700; }
.diag-en { font-size: 22rpx; color: #9aab9f; }
.diag-conf { text-align: right; }
.conf-num { font-size: 40rpx; font-weight: 800; color: #1f7a4d; }
.conf-lab { font-size: 20rpx; color: #9aab9f; }
.bar { height: 12rpx; background: #dcebe2; border-radius: 10rpx; overflow: hidden; margin: 20rpx 0 28rpx; }
.bar-in { height: 100%; background: linear-gradient(90deg, #2e9e5b, #1f7a4d); }
.block { margin-top: 26rpx; }
.block-t { font-size: 26rpx; font-weight: 700; padding-left: 16rpx; border-left: 6rpx solid #1f7a4d; margin-bottom: 12rpx; }
.block-c { font-size: 26rpx; color: #4b5a51; line-height: 1.7; }
.control-item { font-size: 26rpx; color: #4b5a51; line-height: 1.7; margin: 8rpx 0; }
.warn { background: #fff8ec; color: #8a651f; font-size: 22rpx; padding: 16rpx; border-radius: 12rpx; margin-top: 24rpx; }
.full { width: 100%; margin-top: 28rpx; }
.disclaimer { text-align: center; font-size: 20rpx; color: #a5b3aa; padding: 20rpx 40rpx 40rpx; }
